# Copy this file to .env and fill in your keys. Never commit .env.

# --- Model provider (any OpenAI-compatible API) ---
# Development with free Gemini key (https://aistudio.google.com):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_key_here
LLM_MODEL=gemini-2.5-flash

# Final submission with BharatCode (uncomment these, comment the three above):
# LLM_BASE_URL=https://bharatcode.ai/api/model/v1
# LLM_API_KEY=bc_live_your_key_here
# LLM_MODEL=qwen-3.8-27b

LLM_MAX_TOKENS=4000

# --- Telegram (from @BotFather) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Limits ---
MAX_PAGES=5
MAX_UPLOAD_MB=10
DEFAULT_LANG=hi

# --- Deployment only (leave empty locally) ---
# Render sets RENDER_EXTERNAL_URL automatically; set PUBLIC_URL on other hosts.
# PUBLIC_URL=https://your-app.example.com
